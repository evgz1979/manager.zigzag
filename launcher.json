{
  "version": 1,
  "id": "zigzag-manager",
  "name": "Менеджер заказов",
  "enabled": true,
  "services": [
    {
      "id": "web",
      "name": "Открыть на M4",
      "command": [
        "/usr/bin/true"
      ],
      "url": "http://macmini-m4.local:8765",
      "autoStart": false
    },
    {
      "id": "travel",
      "name": "Перенос между M4 и MacBook",
      "command": [
        "/usr/bin/open",
        "./travel.command"
      ],
      "autoStart": false
    }
  ]
}
